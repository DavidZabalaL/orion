DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://usuario:password@host/db?sslmode=require&channel_binding=require"

# Genera uno con: openssl rand -base64 32
AUTH_SECRET=""

# Ver App Registration en Azure/Entra ID (README: sección "Login con Microsoft")
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Correo de invitación (README: sección "Correo de invitación")
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Orión <marketing@grupokabat.com>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Almacenamiento de archivos (pólizas, fotos de checklist, tarjetas) — Vercel Storage → Blob → Create
BLOB_READ_WRITE_TOKEN=""

# Correos del equipo de Desarrollo con acceso total e irrevocable a la plataforma,
# incluido /admin/actividad (Analítica de Uso y Trazabilidad) — separado a propósito
# de la tabla Rol: nadie puede otorgarlo ni quitarlo desde la UI de administración.
# Separados por coma, sin espacios extra necesarios (se hace trim().toLowerCase()).
DEV_ADMIN_EMAILS=""

# Secreto compartido para /api/exec/resumen — lo usa la app externa
# "Dashboard Directivo" vía Authorization: Bearer <valor>. No confundir con
# AUTH_SECRET (ese es de la sesión de usuarios). Genera con: openssl rand -base64 32
EXEC_DASHBOARD_API_KEY=""

# Protege /api/cron/reportes-programados (motor de reportes BI programados).
# Vercel Cron manda este valor automáticamente como "Authorization: Bearer <valor>"
# en las invocaciones programadas si la variable de entorno CRON_SECRET existe en
# el proyecto de Vercel — no hace falta configurarlo aparte en vercel.json.
# En local, sin esta variable el endpoint queda sin proteger (uso solo de desarrollo).
CRON_SECRET=""

# Habilita la capa de IA del motor de BI (consultas en lenguaje natural,
# resúmenes de insights, explicación de forecasts — ver src/lib/ai/). Costo
# por uso, facturado por Google (Gemini API). Sin esta variable, esos
# endpoints responden con un error claro; el resto del explorador de BI
# sigue funcionando normalmente. Genera una en https://aistudio.google.com/apikey
GEMINI_API_KEY=""
