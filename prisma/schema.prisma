// Plataforma de Control Vehicular — Grupo Kabat
// Modelo de datos — ver SPEC_COMPLETA_Control_Vehicular.md Parte 6

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── ENUMS ─────────────────────────

enum TipoVehiculo {
  AUTO
  CAMIONETA
  GRUA
  MOTO
  OTRO
}

enum TipoCombustible {
  GASOLINA
  DIESEL
  ELECTRICO
  HIBRIDO
}

enum EstatusUnidad {
  ACTIVO
  CONSIGNACION
  DIRECCION
  BAJA
}

enum MotivoBaja {
  VENTA
  SINIESTRO_TOTAL
  FIN_VIDA_UTIL
  DEVOLUCION
  CONSIGNACION_CERRADA
  OTRO
}

enum PropietarioUnidad {
  SYM
  FIVE_STAR_SYSTEM
  KABAT
  OTRO
}

enum TipoSangre {
  O_POSITIVO
  O_NEGATIVO
  A_POSITIVO
  A_NEGATIVO
  B_POSITIVO
  B_NEGATIVO
  AB_POSITIVO
  AB_NEGATIVO
}

enum EstatusOperador {
  ACTIVO
  SUSPENDIDO
  BAJA
}

enum EstatusDocumental {
  COMPLETO
  INCOMPLETO
  VENCIDO
}

enum TipoDocumentoOperador {
  LICENCIA
  INE
  COMPROBANTE_DOMICILIO
  ANTECEDENTES
  CSF
  EXAMEN_MEDICO
  ANTIDOPING
  CURSO_MANEJO
  CERTIFICACION
}

enum TipoLicencia {
  A
  B
}

// Tipo de licencia de manejo simplificado para operadores:
// TIPO_A = autos, camionetas, motos; TIPO_B = solo grúas.
enum TipoLicenciaManejo {
  TIPO_A
  TIPO_B
}

enum CategoriaGasto {
  MANTENIMIENTO_PREVENTIVO
  MANTENIMIENTO_CORRECTIVO
  LLANTAS
  REFACCIONES
  CONSUMIBLES
  TENENCIA
  VERIFICACION
  EMPLACAMIENTO
  ESTACIONAMIENTO
  MULTAS
  RENTA_VEHICULOS
  CASETAS
  GASOLINA
  VIATICOS_OPERACION
}

enum OrigenPresupuesto {
  IMPORTADO_EXCEL
  MANUAL
}

enum EstatusGasto {
  PROGRAMADO
  REALIZADO
  PAGADO
  CANCELADO
}

enum FuenteCombustible {
  API
  ARCHIVO
  MANUAL
}

enum ProveedorTag {
  IAVE
  PASE
  TELEVIA
}

enum EstatusSeguro {
  VIGENTE
  POR_VENCER
  VENCIDO
  RENOVADO
}

enum TipoCobertura {
  RC_TERCEROS
  DANOS_MATERIALES
  ROBO_TOTAL
  ROBO_PARCIAL
  GASTOS_MEDICOS
  ASISTENCIA_VIAL
  RC_PERSONAS
  COBERTURA_LEGAL
  PERDIDA_TOTAL
  EXTENSION_RC
  ESPECIAL
}

enum FuenteGPS {
  API
  WEBHOOK
}

enum MotivoAnomaliaGPS {
  VELOCIDAD_IMPOSIBLE
  FUERA_DE_PAIS
  SALTO_DISTANCIA
}

enum TipoGeocerca {
  INMUEBLE
  ZONA_TRABAJO
  RUTA
  PAIS
}

enum CategoriaAuditoria {
  COMBUSTIBLE
  TAG
  MANTENIMIENTO
  OTRO
}

enum TipoDiscrepancia {
  MONTO
  UNIDAD_FALTANTE
  DUPLICADO
  OTRO
}

enum EstatusAuditoria {
  ABIERTA
  RESUELTA
}

enum AccionBitacora {
  CREAR
  EDITAR
  DAR_DE_BAJA
  REACTIVAR
}

enum EstatusProyecto {
  ACTIVO
  CERRADO
}

enum EstatusUsuario {
  ACTIVO
  INVITADO
  DESACTIVADO
}

enum FrecuenciaReporte {
  DIARIO
  SEMANAL
  MENSUAL
}

// ───────────────────────── MÓDULO K — USUARIOS Y ROLES ─────────────────────────

model Rol {
  id        String    @id @default(cuid())
  nombre    String    @unique
  permisos  Json // módulo × acción × proyecto
  usuarios  Usuario[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Usuario {
  id         String            @id @default(cuid())
  nombre     String
  correo     String            @unique
  rolId      String
  rol        Rol               @relation(fields: [rolId], references: [id])
  estatus    EstatusUsuario    @default(INVITADO)
  /** Si tiene fecha, cualquier sesión (JWT) emitida antes de este momento se
   *  considera inválida — ver el callback `session` en src/auth.ts. La usa el
   *  botón "Cerrar sesión" del panel de Analítica de Uso y Trazabilidad. */
  sesionInvalidadaEn DateTime?
  proyectos  UsuarioProyecto[]
  operadorId String?           @unique
  operador   Operador?         @relation(fields: [operadorId], references: [id])
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  bitacora                      BitacoraCambio[]
  checklists                    Checklist[]
  documentosVerificados         DocumentoOperador[]
  auditorias                    Auditoria[]
  reportesProgramados           ReporteProgramado[]
  configuracionesNotificaciones ConfiguracionNotificaciones[]
  presupuestosPartidaCargados   PresupuestoPartida[]
  notificacionesLeidas          NotificacionLeida[]
  vistasDashboardBI             VistaDashboardBI[]
  actividad                     ActivityLog[]
  ticketsReportados             TicketRescate[] @relation("TicketReportadoPor")
  ticketsAsignados              TicketRescate[] @relation("TicketAsignadoA")
  historicoTickets              HistoricoTicketRescate[]
}

model UsuarioProyecto {
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, proyectoId])
}

model Documento {
  id                 String   @id @default(cuid())
  entidadRelacionada String
  entidadId          String
  url                String
  tipo               String
  fechaCarga         DateTime @default(now())

  operadoresFoto           Operador[]          @relation("OperadorFoto")
  documentosOperador       DocumentoOperador[]
  gastos                   GastoVehicular[]
  checklists               Checklist[]
  seguros                  Seguro[]
  unidadTarjetaCirculacion Unidad?             @relation("TarjetaCirculacion")
}

// ───────────────────────── MÓDULO H — PROYECTOS ─────────────────────────

model Proyecto {
  id                       String          @id @default(cuid())
  nombre                   String
  estadoRepublica          String
  coordinadorId            String?
  fechaInicio              DateTime
  fechaFin                 DateTime?
  estatus                  EstatusProyecto @default(ACTIVO)
  presupuestoAprobadoAnual Decimal         @default(0) @db.Decimal(12, 2)
  modulosActivos           Json
  procesosActivos          Json

  unidades              Unidad[]
  operadores            Operador[]
  usuarios              UsuarioProyecto[]
  gastosTag             Tag[]
  combustible           Combustible[]
  geocercas             Geocerca[]
  presupuestosMensuales PresupuestoMensual[]
  presupuestosPartida   PresupuestoPartida[]
  gastosReportados      GastoVehicular[]
  insumos               InsumoInventario[]
  tickets               TicketRescate[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model PresupuestoMensual {
  id            String   @id @default(cuid())
  proyectoId    String
  proyecto      Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  anio          Int
  mes           Int
  montoAsignado Decimal  @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([proyectoId, anio, mes])
  @@index([proyectoId, anio])
}

model PresupuestoPartida {
  id                  String            @id @default(cuid())
  proyectoId          String
  proyecto            Proyecto          @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  categoria           CategoriaGasto
  anio                Int
  mes                 Int
  montoPresupuestado  Decimal           @default(0) @db.Decimal(12, 2)
  origen              OrigenPresupuesto @default(MANUAL)
  archivoOrigenNombre String?
  version             Int               @default(1)
  cargadoPorId        String
  cargadoPor          Usuario           @relation(fields: [cargadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([proyectoId, categoria, anio, mes])
  @@index([proyectoId, anio])
}

// ───────────────────────── MÓDULO A/B — UNIDAD ─────────────────────────

model Unidad {
  numeroEconomico       String          @id
  placas                String          @unique
  numeroSerie           String          @unique
  marca                 String
  unidadModelo          String
  anio                  Int
  tipoVehiculo          TipoVehiculo
  tipoCombustible       TipoCombustible
  rendimientoPromedio   Decimal?        @db.Decimal(6, 2)
  kmOficial             Int             @default(0)
  capacidadTanqueLitros Decimal?        @db.Decimal(6, 2)

  proyectoId String?
  proyecto   Proyecto? @relation(fields: [proyectoId], references: [id])

  estatus                   EstatusUnidad @default(ACTIVO)
  disponibilidad            Boolean       @default(true)
  diasSinOperar             Int           @default(0)
  /// Fecha del último cambio de `disponibilidad` (botón de encendido/apagado).
  /// Cuando está apagada, "días sin operar" se cuenta desde aquí.
  fechaCambioDisponibilidad DateTime?

  resguardanteId String?
  resguardante   Operador? @relation("ResguardanteActual", fields: [resguardanteId], references: [id])

  licenciaRequerida TipoLicenciaManejo?

  propietario PropietarioUnidad
  origenPlaca String
  tagIave     String?

  numeroTarjetaCombustible String?
  tarjetaCirculacionId     String?    @unique
  tarjetaCirculacion       Documento? @relation("TarjetaCirculacion", fields: [tarjetaCirculacionId], references: [id])

  fechaAlta      DateTime    @default(now())
  fechaBaja      DateTime?
  motivoBaja     MotivoBaja?
  comentarioBaja String?

  asignaciones    AsignacionOperador[]
  resguardos      Resguardo[]
  checklists      Checklist[]
  gastos          GastoVehicular[]
  combustible     Combustible[]
  tags            Tag[]
  seguros         Seguro[]
  posicionesGps   PosicionGPS[]
  huecosGps       HuecoSenalGPS[]
  mapeoTarjetas   MapeoTarjetaEconomico[]
  auditorias      Auditoria[]
  placasHistorial Placa[]
  accidentes      Accidente[]
  tickets         TicketRescate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proyectoId])
  @@index([estatus])
}

model Placa {
  id              String    @id @default(cuid())
  numeroEconomico String
  unidad          Unidad    @relation(fields: [numeroEconomico], references: [numeroEconomico])
  placa           String
  fechaDesde      DateTime  @default(now())
  fechaHasta      DateTime?
  motivo          String?
  createdAt       DateTime  @default(now())

  @@index([numeroEconomico])
}

// ───────────────────────── MÓDULO L — OPERADORES ─────────────────────────

model Operador {
  id                 String      @id @default(cuid())
  nombre             String
  curp               String      @unique
  rfc                String?
  nss                String?
  tipoSangre              TipoSangre?
  telefono                String?
  contactoEmergencia      String?
  fotoId                  String?
  foto                    Documento?           @relation("OperadorFoto", fields: [fotoId], references: [id])
  tipoLicenciaManejo      TipoLicenciaManejo?
  fechaUltimaCapacitacion DateTime?
  licenciaDocumentoUrl    String?

  proyectoId String?
  proyecto   Proyecto? @relation(fields: [proyectoId], references: [id])

  estatus           EstatusOperador   @default(ACTIVO)
  estatusDocumental EstatusDocumental @default(INCOMPLETO)

  documentos           DocumentoOperador[]
  asignaciones         AsignacionOperador[]
  resguardos           Resguardo[]
  unidadesResguardadas Unidad[]             @relation("ResguardanteActual")
  usuario              Usuario?
  accidentes           Accidente[]
  cursos               CursoOperador[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proyectoId])
}

model DocumentoOperador {
  id                String                @id @default(cuid())
  operadorId        String
  operador          Operador              @relation(fields: [operadorId], references: [id], onDelete: Cascade)
  tipoDocumento     TipoDocumentoOperador
  numero            String?
  tipoLicencia      TipoLicencia?
  estadoEmisor      String?
  fechaEmision      DateTime
  fechaVencimiento  DateTime?
  archivoId         String
  archivo           Documento             @relation(fields: [archivoId], references: [id])
  verificado        Boolean               @default(false)
  fechaVerificacion DateTime?
  verificadoPorId   String?
  verificadoPor     Usuario?              @relation(fields: [verificadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operadorId])
  @@index([fechaVencimiento])
}

model AsignacionOperador {
  id              String    @id @default(cuid())
  operadorId      String
  operador        Operador  @relation(fields: [operadorId], references: [id])
  numeroEconomico String
  unidad          Unidad    @relation(fields: [numeroEconomico], references: [numeroEconomico])
  fechaDesde      DateTime
  fechaHasta      DateTime?
  motivoCambio    String?

  @@index([numeroEconomico])
  @@index([operadorId])
}

model Resguardo {
  id              String    @id @default(cuid())
  numeroEconomico String
  unidad          Unidad    @relation(fields: [numeroEconomico], references: [numeroEconomico])
  operadorId      String
  operador        Operador  @relation(fields: [operadorId], references: [id])
  fechaDesde      DateTime
  fechaHasta      DateTime?
  motivoCambio    String?

  @@index([numeroEconomico])
  @@index([operadorId])
}

// ───────────────────────── MÓDULO A.1 — CHECKLIST ─────────────────────────

enum TipoChecklist {
  DIARIO
  SEMANAL
}

model Checklist {
  id                String        @id @default(cuid())
  numeroEconomico   String
  unidad            Unidad        @relation(fields: [numeroEconomico], references: [numeroEconomico])
  tipo              TipoChecklist @default(DIARIO)
  fecha             DateTime
  odometro          Int?
  horometro         Int?
  puntosInspeccion  Json // solo DIARIO: { puntoKey: "ok" | "revisar" }
  respuestasSemanal Json? // solo SEMANAL: todas las respuestas del checklist de 59 campos (ver src/lib/checklist-semanal.ts)
  evidenciaId       String?
  evidencia         Documento?    @relation(fields: [evidenciaId], references: [id])
  capturadoPorId    String
  capturadoPor      Usuario       @relation(fields: [capturadoPorId], references: [id])

  createdAt DateTime @default(now())

  @@index([numeroEconomico, fecha])
  @@index([tipo, fecha])
}

// ───────────────────────── MÓDULO C — GASTOS VEHICULARES ─────────────────────────

model GastoVehicular {
  id                   String         @id @default(cuid())
  numeroEconomico      String?
  unidad               Unidad?        @relation(fields: [numeroEconomico], references: [numeroEconomico])
  proyectoReportanteId String?
  proyectoReportante   Proyecto?      @relation(fields: [proyectoReportanteId], references: [id])
  categoria            CategoriaGasto
  descripcion          String?
  fecha                DateTime
  costo                Decimal        @db.Decimal(12, 2)
  kmAlMomento          Int?
  proveedor            String?
  servicio             String?
  empresa              String?

  sc               String?
  odc              String?
  entradaSap       String?
  fechaRequisicion DateTime?
  fechaOdc         DateTime?
  fechaFactura     DateTime?
  fechaCxp         DateTime?
  fechaPago        DateTime?

  fechaIngresoTaller    DateTime?
  fechaEstimadaSalida   DateTime?

  evidenciaId String?
  evidencia   Documento?   @relation(fields: [evidenciaId], references: [id])
  estatus     EstatusGasto @default(PROGRAMADO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([numeroEconomico])
  @@index([categoria])
  @@index([proyectoReportanteId])
}

// ───────────────────────── MÓDULO D — COMBUSTIBLE ─────────────────────────

model ConfiguracionProveedorCombustible {
  id            String        @id @default(cuid())
  nombre        String        @unique
  mapeoColumnas Json
  formatoFecha  String
  combustible   Combustible[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Combustible {
  id                   String                             @id @default(cuid())
  numeroEconomico      String
  unidad               Unidad                             @relation(fields: [numeroEconomico], references: [numeroEconomico])
  fecha                DateTime
  litros               Decimal                            @db.Decimal(10, 2)
  costo                Decimal                            @db.Decimal(12, 2)
  kmActual             Int
  estacion             String?
  rfcEstacion          String?
  proyectoReportanteId String?
  proyectoReportante   Proyecto?                          @relation(fields: [proyectoReportanteId], references: [id])
  fuente               FuenteCombustible                  @default(MANUAL)
  proveedorConfigId    String?
  proveedorConfig      ConfiguracionProveedorCombustible? @relation(fields: [proveedorConfigId], references: [id])
  rendimientoCalculado Decimal?                           @db.Decimal(6, 2)
  nivelEstimadoDespues Decimal?                           @db.Decimal(6, 2)
  alertaSobrellenado   Boolean                            @default(false)

  createdAt DateTime @default(now())

  @@index([numeroEconomico, fecha])
}

model MapeoTarjetaEconomico {
  numeroTarjeta   String    @id
  placaAsociada   String?
  numeroEconomico String
  unidad          Unidad    @relation(fields: [numeroEconomico], references: [numeroEconomico])
  proveedor       String
  vigenciaDesde   DateTime
  vigenciaHasta   DateTime?

  @@index([numeroEconomico])
}

// ───────────────────────── MÓDULO E — TAG / PEAJES ─────────────────────────

model Tag {
  id                   String       @id @default(cuid())
  numeroEconomico      String?
  unidad               Unidad?      @relation(fields: [numeroEconomico], references: [numeroEconomico])
  fecha                DateTime
  monto                Decimal      @db.Decimal(10, 2)
  caseta               String?
  proveedorTag         ProveedorTag
  tarjetaIdmx          String?
  proyectoReportanteId String?
  proyectoReportante   Proyecto?    @relation(fields: [proyectoReportanteId], references: [id])
  conciliado           Boolean      @default(false)

  createdAt DateTime @default(now())

  @@index([numeroEconomico, fecha])
}

// ───────────────────────── MÓDULO F — SEGUROS ─────────────────────────

model Seguro {
  id               String        @id @default(cuid())
  numeroEconomico  String
  unidad           Unidad        @relation(fields: [numeroEconomico], references: [numeroEconomico])
  aseguradora      String
  numeroPoliza     String
  fechaInicio      DateTime
  fechaVencimiento DateTime
  costo            Decimal       @db.Decimal(12, 2)
  documentoId      String?
  documento        Documento?    @relation(fields: [documentoId], references: [id])
  estatus          EstatusSeguro @default(VIGENTE)

  coberturas CoberturaSeguro[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([numeroEconomico])
  @@index([fechaVencimiento])
}

model CoberturaSeguro {
  id                    String        @id @default(cuid())
  seguroId              String
  seguro                Seguro        @relation(fields: [seguroId], references: [id], onDelete: Cascade)
  tipoCobertura         TipoCobertura
  sumaAsegurada         Decimal       @db.Decimal(12, 2)
  deducible             Decimal       @db.Decimal(12, 2)
  condicionesEspeciales String?

  @@index([seguroId])
}

// ───────────────────────── MÓDULO G / G.1 — GEOLOCALIZACIÓN ─────────────────────────

model PosicionGPS {
  id              String             @id @default(cuid())
  numeroEconomico String
  unidad          Unidad             @relation(fields: [numeroEconomico], references: [numeroEconomico])
  lat             Decimal            @db.Decimal(9, 6)
  lng             Decimal            @db.Decimal(9, 6)
  velocidad       Decimal?           @db.Decimal(6, 2)
  timestamp       DateTime
  fuente          FuenteGPS
  kmReportado     Int?
  kmValidado      Int?
  esAnomalo       Boolean            @default(false)
  motivoAnomalia  MotivoAnomaliaGPS?

  @@index([numeroEconomico, timestamp])
}

model HuecoSenalGPS {
  id                 String    @id @default(cuid())
  numeroEconomico    String
  unidad             Unidad    @relation(fields: [numeroEconomico], references: [numeroEconomico])
  ultimaPosicionLat  Decimal   @db.Decimal(9, 6)
  ultimaPosicionLng  Decimal   @db.Decimal(9, 6)
  timestampInicio    DateTime
  timestampFin       DateTime?
  duracionMinutos    Int?
  primeraPosicionLat Decimal?  @db.Decimal(9, 6)
  primeraPosicionLng Decimal?  @db.Decimal(9, 6)
  distanciaSaltoKm   Decimal?  @db.Decimal(8, 2)
  patronRecurrente   Boolean   @default(false)

  @@index([numeroEconomico])
}

model Geocerca {
  id         String       @id @default(cuid())
  nombre     String
  tipo       TipoGeocerca
  poligono   Json
  proyectoId String?
  proyecto   Proyecto?    @relation(fields: [proyectoId], references: [id])
  horaLimite String?
  activa     Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────────── MÓDULO I — AUDITORÍA ─────────────────────────

model Auditoria {
  id               String             @id @default(cuid())
  numeroEconomico  String
  unidad           Unidad             @relation(fields: [numeroEconomico], references: [numeroEconomico])
  fechaRevision    DateTime
  revisorId        String
  revisor          Usuario            @relation(fields: [revisorId], references: [id])
  categoriaGasto   CategoriaAuditoria
  montoPptto       Decimal            @db.Decimal(12, 2)
  montoReal        Decimal            @db.Decimal(12, 2)
  montoCv          Decimal            @db.Decimal(12, 2)
  diferencia       Decimal            @db.Decimal(12, 2)
  tipoDiscrepancia TipoDiscrepancia?
  resolucion       String?
  estatus          EstatusAuditoria   @default(ABIERTA)

  createdAt DateTime @default(now())

  @@index([numeroEconomico, fechaRevision])
}

// ───────────────────────── BITÁCORA ─────────────────────────

model BitacoraCambio {
  id                String         @id @default(cuid())
  entidad           String
  entidadId         String
  usuarioId         String
  usuario           Usuario        @relation(fields: [usuarioId], references: [id])
  timestamp         DateTime       @default(now())
  accion            AccionBitacora
  valoresAnteriores Json?
  valoresNuevos     Json?

  @@index([entidad, entidadId])
}

// ───────────────────────── MÓDULO J — REPORTES ─────────────────────────

model ReporteProgramado {
  id            String            @id @default(cuid())
  nombre        String
  tipo          String
  camposJson    Json
  filtrosJson   Json
  destinatarios Json
  hora          String
  frecuencia    FrecuenciaReporte
  activo        Boolean           @default(true)
  creadoPorId   String
  creadoPor     Usuario           @relation(fields: [creadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────────── CONFIGURACIÓN DE ALERTAS / NOTIFICACIONES ─────────────────────────

model ConfiguracionNotificaciones {
  id String @id @default(cuid())

  // Módulo A — unidad disponible sin reporte GPS
  alertaGpsSinSenalHoras  Int     @default(48)
  alertaGpsSinSenalActiva Boolean @default(true)

  // Módulo C — mantenimiento / tenencia / verificación / renta
  alertaMantenimientoDiasPrevios Int[]   @default([15, 5])
  alertaMantenimientoActiva      Boolean @default(true)

  // Módulo D — caída de rendimiento de combustible
  alertaRendimientoUmbralPct Int     @default(20)
  alertaRendimientoActiva    Boolean @default(true)

  // Módulo F — vencimiento de seguros
  alertaSeguroDiasPrevios Int[]   @default([30, 7])
  alertaSeguroActiva      Boolean @default(true)

  // Módulo G.1 — señal GPS perdida
  alertaSenalPerdidaMinutos Int     @default(15)
  alertaSenalPerdidaActiva  Boolean @default(true)

  // Módulo I — checklist diario faltante
  alertaChecklistFaltanteActiva Boolean @default(true)
  alertaChecklistHoraLimite     String  @default("18:00")

  // Módulo L — documentación de operadores
  alertaDocumentoOperadorDiasPrevios Int[]   @default([60, 30, 7])
  alertaDocumentoOperadorActiva      Boolean @default(true)

  // Presupuesto por partida — recarga
  alertaRecargaPresupuestoActiva Boolean @default(true)

  destinatariosCorreo Json

  actualizadoPorId String?
  actualizadoPor   Usuario? @relation(fields: [actualizadoPorId], references: [id])
  updatedAt        DateTime @updatedAt
}

// ───────────────────────── MANTENIMIENTO PREVENTIVO ─────────────────────────

model ConfiguracionMantenimientoPreventivo {
  id             String       @id @default(cuid())
  tipoVehiculo   TipoVehiculo @unique
  intervaloKm    Int
  intervaloHoras Int?
  updatedAt      DateTime     @updatedAt
}

// ───────────────────────── WIDGETS CONFIGURABLES ─────────────────────────

model ConfiguracionWidgets {
  id        String   @id @default(cuid())
  moduloId  String   @unique
  widgets   Json
  updatedAt DateTime @updatedAt
}

// ───────────────────────── DASHBOARDS BI — VISTAS GUARDADAS ─────────────────────────

model VistaDashboardBI {
  id          String   @id @default(cuid())
  nombre      String
  widgets     Json
  creadoPorId String?
  creadoPor   Usuario? @relation(fields: [creadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ───────────────────────── ANALÍTICA DE USO Y TRAZABILIDAD ─────────────────────────
// Capa independiente de BitacoraCambio: BitacoraCambio audita cambios de datos de
// negocio puntuales (unidades, operadores, presupuesto...); ActivityLog es el log
// de actividad de toda la plataforma (login/logout incluido) para adopción y
// trazabilidad. Append-only por convención de aplicación — nunca se actualiza ni
// se borra un registro desde el código (ver src/lib/activity.ts).

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  usuario   Usuario  @relation(fields: [userId], references: [id])
  modulo    String
  accion    String
  entidad   String?
  entidadId String?
  detalle   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entidad, entidadId])
  @@index([modulo, createdAt])
}

// ───────────────────────── NOTIFICACIONES LEÍDAS ─────────────────────────

model NotificacionLeida {
  id             String   @id @default(cuid())
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  notificacionId String
  leidaEn        DateTime @default(now())

  @@unique([usuarioId, notificacionId])
  @@index([usuarioId])
}

// ───────────────────────── ACCIDENTES / SINIESTROS ─────────────────────────

model Accidente {
  id              String    @id @default(cuid())
  fecha           DateTime
  descripcion     String
  tipo            String    // "choque", "raspón", "robo parcial", "otro"
  numeroEconomico String
  unidad          Unidad    @relation(fields: [numeroEconomico], references: [numeroEconomico])
  operadorId      String?
  operador        Operador? @relation(fields: [operadorId], references: [id])
  evidencias      String[]
  registradoPorId String?   // ID del usuario que registró (sin FK formal para evitar circular)
  createdAt       DateTime  @default(now())

  @@index([numeroEconomico])
  @@index([operadorId])
}

// ───────────────────────── CURSOS Y CAPACITACIONES DE OPERADOR ─────────────────────────

model CursoOperador {
  id           String   @id @default(cuid())
  operadorId   String
  operador     Operador @relation(fields: [operadorId], references: [id], onDelete: Cascade)
  nombre       String
  fecha        DateTime
  evidenciaUrl String?
  createdAt    DateTime @default(now())

  @@index([operadorId])
}

// ───────────────────────── MÓDULO G — INVENTARIO DE INSUMOS ─────────────────────────

model InsumoInventario {
  id          String   @id @default(cuid())
  proyectoId  String
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombre      String
  categoria   String?
  unidad      String   @default("pza")
  existencias Decimal  @default(0) @db.Decimal(12, 2)
  minimoStock Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([proyectoId])
}

// ───────────────────────── MÓDULO R — RESCATE DE UNIDADES ─────────────────────────

enum CategoriaRescate {
  MECANICO
  ELECTRICO
  NEUMATICO
  ACCIDENTE
  SEGURIDAD
  COMBUSTIBLE
  OTRO
}

enum PrioridadRescate {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum EstatusTicketRescate {
  ABIERTO
  ASIGNADO
  EN_ATENCION
  EN_TRANSITO
  RESUELTO
  CERRADO
  CANCELADO
}

model CatalogoMotivoRescate {
  id               String           @id @default(cuid())
  nombre           String           @unique
  categoria        CategoriaRescate
  prioridadDefault PrioridadRescate @default(MEDIA)
  activo           Boolean          @default(true)
  createdAt        DateTime         @default(now())

  tickets TicketRescate[]
}

model TicketRescate {
  id              String               @id @default(cuid())
  folio           String               @unique
  numeroEconomico String
  unidad          Unidad               @relation(fields: [numeroEconomico], references: [numeroEconomico])
  motivoId        String
  motivo          CatalogoMotivoRescate @relation(fields: [motivoId], references: [id])
  descripcion     String?
  prioridad       PrioridadRescate     @default(MEDIA)
  estatus         EstatusTicketRescate @default(ABIERTO)
  ubicacion       String?
  latitud         Decimal?             @db.Decimal(10, 7)
  longitud        Decimal?             @db.Decimal(10, 7)
  reportadoPorId  String
  reportadoPor    Usuario              @relation("TicketReportadoPor", fields: [reportadoPorId], references: [id])
  asignadoAId     String?
  asignadoA       Usuario?             @relation("TicketAsignadoA", fields: [asignadoAId], references: [id])
  proyectoId      String?
  proyecto        Proyecto?            @relation(fields: [proyectoId], references: [id])
  cerradoAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  historico HistoricoTicketRescate[]

  @@index([numeroEconomico])
  @@index([estatus])
  @@index([proyectoId])
  @@index([folio])
}

model HistoricoTicketRescate {
  id         String               @id @default(cuid())
  ticketId   String
  ticket     TicketRescate        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  estatus    EstatusTicketRescate
  comentario String?
  usuarioId  String
  usuario    Usuario              @relation(fields: [usuarioId], references: [id])
  createdAt  DateTime             @default(now())

  @@index([ticketId])
}
